# Kite Connect app credentials (developers.kite.trade). The daily access token is NOT stored here: run `zt login`.
KITE_API_KEY=
KITE_API_SECRET_TOKEN=

# Backtest equity and history window (calendar days back from yesterday)
PERFORMANCE_EQUITY_BALANCE=100000
PERFORMANCE_HISTORIC_DURATION=90

# "Proven profitable" thresholds (docs/PLAN.md sections 8 and 17)
PERFORMANCE_MIN_POSITIONS=40
PERFORMANCE_MIN_PROFIT_FACTOR=1.3
PERFORMANCE_MIN_SHARPE_RATIO=1.0
PERFORMANCE_MAX_DRAWDOWN_PERCENTAGE=0.10
PERFORMANCE_MIN_RECOVERY_FACTOR=2
PERFORMANCE_MIN_EXPECTANCY_RATE=0
PERFORMANCE_MIN_SCORE=0.5
PERFORMANCE_STABILITY_PROFIT_FACTOR=1.1
PERFORMANCE_STABILITY_SHARPE_RATIO=0.5

# Zerodha intraday equity charges (2026). Fractions of turnover, except the brokerage cap in rupees and GST on charges.
ZERODHA_MAX_BROKERAGE=20
ZERODHA_BROKERAGE=0.0003
ZERODHA_STT=0.00025
ZERODHA_NSE=0.0000307
ZERODHA_BSE=0.0000375
ZERODHA_SEBI=0.000001
ZERODHA_GST=0.18
ZERODHA_STAMP_DUTY=0.00003

# Optional paths (defaults shown)
# ZT_DATA_DIR=data
# ZT_LOGS_DIR=logs
# ZT_DB=data/zt.db
# ZT_SESSION_FILE=data/session.json
